# Copy this file to backend/.env and replace every placeholder with local values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

DB_NAME=quiz_generator
DB_USER=quiz_app
DB_HOST=127.0.0.1
DB_PORT=5432
